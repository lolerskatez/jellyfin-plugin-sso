<Project>
  <PropertyGroup>
    <Version>0.1.0.4</Version>
    <AssemblyVersion>0.1.0.4</AssemblyVersion>
    <FileVersion>0.1.0.4</FileVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;CA1812;CA1848;CA2007;CA1031;CA1303;CA1305;CA1310;CA5394;CA1054;CA1056;CA1001;CA1002;CA1716;CA1822;CA1859;CA1873;CA2227</NoWarn>
  </PropertyGroup>
</Project>
